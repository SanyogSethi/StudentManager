<div class="top-header">
  <div class="header-title">
    <h1>AI Personalized Learning Hub</h1>
    <p>Targeted study recommendations, skill gap analysis, and practice plans generated by Gemini AI</p>
  </div>
  <div class="header-actions">
    <button class="btn btn-ai" id="refreshAiBtn" onclick="regenerateInsight()">
      <span class="ai-sparkle">✨</span> Generate Fresh AI Analysis
    </button>
  </div>
</div>

<!-- AI Banner -->
<div class="ai-banner" style="margin-bottom: 1.5rem;">
  <div class="ai-header" style="justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span class="ai-sparkle">🤖</span>
      <div class="ai-title">Gemini AI Executive Study Coach</div>
    </div>
    <div style="font-size: 0.78rem; background: rgba(0,0,0,0.3); padding: 0.25rem 0.6rem; border-radius: 20px; color: var(--accent-cyan);">
      Updated: <span id="lastUpdatedTime"><%= new Date(insight ? insight.createdAt : Date.now()).toLocaleTimeString() %></span>
    </div>
  </div>
  
  <p class="ai-body" id="aiSummaryText" style="font-size: 1.05rem; margin-top: 0.5rem;">
    <%= insight ? insight.summary : summary.student.name + ' is maintaining steady progress. Follow the target study path below.' %>
  </p>
  
  <div style="margin-top: 0.8rem; font-size: 0.78rem; color: var(--accent-cyan); font-weight: 600;">
    Model Provider: <span id="aiProviderText"><%= insight ? insight.generatedBy : 'Smart Dynamic Engine' %></span>
  </div>
</div>

<!-- Interactive AI Study Coach Assistant Chat Widget -->
<div class="glass-card" style="margin-bottom: 1.5rem; border-color: rgba(168, 85, 247, 0.4); background: linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(24, 16, 45, 0.6));">
  <div class="ai-header" style="margin-bottom: 1rem;">
    <span class="ai-sparkle">💬</span>
    <h2 style="font-size: 1.15rem; font-weight: 700; color: #fff;">Ask Your AI Personal Study Coach</h2>
  </div>

  <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1rem;">
    Type any question regarding your subject topics, exam preparation, or study schedule for instant tailored guidance:
  </p>

  <!-- Quick Prompt Suggestion Chips -->
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
    <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-radius: 20px;" onclick="askPreset('Give me a 3-day Math calculus revision plan')">💡 Calculus Study Plan</button>
    <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-radius: 20px;" onclick="askPreset('Explain Binary Search Trees simply with an example')">💻 Binary Trees Concept</button>
    <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-radius: 20px;" onclick="askPreset('How can I manage my exam time effectively?')">⏱️ Exam Time Management</button>
    <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-radius: 20px;" onclick="askPreset('How to improve my Quantum Physics marks?')">⚛️ Quantum Physics Tips</button>
  </div>

  <div style="display: flex; gap: 0.75rem;">
    <input type="text" id="coachQuestionInput" class="form-control" placeholder="Ask Aegis AI e.g. 'How can I prepare for my upcoming Midterm?'" onkeypress="if(event.key==='Enter') sendCoachQuestion()">
    <button type="button" class="btn btn-ai" style="padding: 0.75rem 1.5rem;" onclick="sendCoachQuestion()">Ask AI</button>
  </div>

  <div id="coachResponseContainer" style="display: none; margin-top: 1.25rem; background: rgba(0,0,0,0.4); border: 1px solid var(--border-glow); padding: 1.25rem; border-radius: var(--radius-md);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.5rem;">
      <strong style="color: var(--accent-cyan); font-size: 0.9rem;">🤖 Aegis AI Study Coach Answer</strong>
      <span id="coachProviderBadge" class="badge badge-indigo" style="font-size: 0.72rem;">Gemini AI</span>
    </div>
    <div id="coachResponseBody" style="color: #e5e7eb; font-size: 0.92rem; line-height: 1.6; white-space: pre-line;"></div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
  <!-- Recognized Strengths -->
  <div class="glass-card">
    <h3 style="color: var(--accent-emerald); font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>🌟</span> Identified Mastery Areas
    </h3>
    <ul id="strengthsList" style="display: flex; flex-direction: column; gap: 0.75rem; list-style: none;">
      <% (insight && insight.strengths ? insight.strengths : ['Consistent attendance rate', 'High participation']).forEach(str => { %>
        <li style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); padding: 0.75rem 1rem; border-radius: 10px; color: #fff; font-size: 0.9rem;">
          ✔ <%= str %>
        </li>
      <% }); %>
    </ul>
  </div>

  <!-- Priority Focus Areas -->
  <div class="glass-card">
    <h3 style="color: var(--accent-rose); font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>🎯</span> Focus & Support Target Areas
    </h3>
    <ul id="supportAreasList" style="display: flex; flex-direction: column; gap: 0.75rem; list-style: none;">
      <% (insight && insight.supportAreas ? insight.supportAreas : ['Time management', 'Revision in weak topics']).forEach(sup => { %>
        <li style="background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); padding: 0.75rem 1rem; border-radius: 10px; color: #fff; font-size: 0.9rem;">
          ⚠️ <%= sup %>
        </li>
      <% }); %>
    </ul>
  </div>
</div>

<!-- Recommended Action Plan Cards -->
<div class="glass-card">
  <h3 style="color: #fff; font-size: 1.15rem; margin-bottom: 1.25rem;">Actionable AI Study Plan</h3>
  
  <div id="recommendationsGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
    <% if (insight && insight.recommendations) { %>
      <% insight.recommendations.forEach(rec => { %>
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <strong style="color: var(--accent-cyan); font-size: 0.95rem;"><%= rec.topic %></strong>
            <span class="badge badge-<%= rec.priority === 'High' ? 'high' : 'moderate' %>"><%= rec.priority %> Priority</span>
          </div>
          <p style="color: #d1d5db; font-size: 0.88rem; line-height: 1.5; margin-bottom: 0.75rem;"><%= rec.action %></p>
          <div style="font-size: 0.78rem; color: var(--text-dim); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
            Recommended Resource: <strong style="color: var(--accent-purple);"><%= rec.resourceType %></strong>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<script>
  async function regenerateInsight() {
    const btn = document.getElementById('refreshAiBtn');
    btn.innerHTML = '<span class="ai-sparkle">⏳</span> Generating Fresh Insights...';
    btn.disabled = true;

    const studentId = '<%= summary.student.id %>';
    try {
      const res = await API.triggerAiInsight(studentId);
      if (res.success && res.data) {
        const d = res.data;
        showToast('Fresh AI Study Plan Generated!', 'success');

        // Update DOM elements dynamically without requiring a hard refresh
        document.getElementById('aiSummaryText').innerText = d.summary;
        document.getElementById('aiProviderText').innerText = d.generatedBy;
        document.getElementById('lastUpdatedTime').innerText = new Date().toLocaleTimeString();

        // Update Strengths
        const strList = document.getElementById('strengthsList');
        strList.innerHTML = (d.strengths || []).map(s => `
          <li style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); padding: 0.75rem 1rem; border-radius: 10px; color: #fff; font-size: 0.9rem;">
            ✔ ${s}
          </li>
        `).join('');

        // Update Support Areas
        const supList = document.getElementById('supportAreasList');
        supList.innerHTML = (d.supportAreas || []).map(s => `
          <li style="background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); padding: 0.75rem 1rem; border-radius: 10px; color: #fff; font-size: 0.9rem;">
            ⚠️ ${s}
          </li>
        `).join('');

        // Update Recommendations
        const recGrid = document.getElementById('recommendationsGrid');
        recGrid.innerHTML = (d.recommendations || []).map(r => `
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <strong style="color: var(--accent-cyan); font-size: 0.95rem;">${r.topic}</strong>
              <span class="badge badge-${r.priority === 'High' ? 'high' : 'moderate'}">${r.priority} Priority</span>
            </div>
            <p style="color: #d1d5db; font-size: 0.88rem; line-height: 1.5; margin-bottom: 0.75rem;">${r.action}</p>
            <div style="font-size: 0.78rem; color: var(--text-dim); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
              Recommended Resource: <strong style="color: var(--accent-purple);">${r.resourceType}</strong>
            </div>
          </div>
        `).join('');
      } else {
        showToast('Error generating AI plan', 'error');
      }
    } catch(err) {
      showToast('Network error generating AI plan', 'error');
    } finally {
      btn.innerHTML = '<span class="ai-sparkle">✨</span> Generate Fresh AI Analysis';
      btn.disabled = false;
    }
  }

  function askPreset(promptText) {
    document.getElementById('coachQuestionInput').value = promptText;
    sendCoachQuestion();
  }

  async function sendCoachQuestion() {
    const input = document.getElementById('coachQuestionInput');
    const question = input.value.trim();
    if (!question) return;

    const container = document.getElementById('coachResponseContainer');
    const body = document.getElementById('coachResponseBody');
    const badge = document.getElementById('coachProviderBadge');

    container.style.display = 'block';
    body.innerHTML = '⚡ Aegis AI Study Coach is analyzing your question...';

    try {
      const studentId = '<%= summary.student.id %>';
      const res = await fetch('/api/v1/ai/ask-coach', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, question })
      }).then(r => r.json());

      if (res.success && res.data) {
        badge.innerText = res.data.provider;
        body.innerText = res.data.answer;
      } else {
        body.innerText = 'Failed to fetch AI answer. Please try again.';
      }
    } catch(err) {
      body.innerText = 'Error connecting to AI Coach.';
    }
  }
</script>
