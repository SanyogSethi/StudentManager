<div class="top-header">
  <div class="header-title">
    <h1>Administrator Control Center</h1>
    <p>Real-time institutional oversight & AI academic risk analytics</p>
  </div>
  <div class="header-actions">
    <a href="/admin/users" class="btn btn-secondary">👥 Manage Users</a>
    <a href="/admin/classes" class="btn btn-primary">+ Create Class</a>
  </div>
</div>

<!-- Metrics Overview Grid -->
<div class="grid-metrics">
  <div class="glass-card metric-card">
    <div class="metric-data">
      <h3>Total Students</h3>
      <div class="metric-value"><%= metrics.totalStudents %></div>
    </div>
    <div class="metric-icon-box bg-indigo">🎓</div>
  </div>

  <div class="glass-card metric-card">
    <div class="metric-data">
      <h3>Faculty Teachers</h3>
      <div class="metric-value"><%= metrics.totalTeachers %></div>
    </div>
    <div class="metric-icon-box bg-cyan">👩‍🏫</div>
  </div>

  <div class="glass-card metric-card">
    <div class="metric-data">
      <h3>Active Classes</h3>
      <div class="metric-value"><%= metrics.totalClasses %></div>
    </div>
    <div class="metric-icon-box bg-emerald">🏫</div>
  </div>

  <div class="glass-card metric-card">
    <div class="metric-data">
      <h3>At-Risk Flagged</h3>
      <div class="metric-value" style="color: var(--accent-rose);"><%= metrics.atRiskCount %></div>
    </div>
    <div class="metric-icon-box bg-rose">🚨</div>
  </div>
</div>

<!-- AI At-Risk Student Alert Leaderboard -->
<div class="glass-card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
    <div class="ai-header" style="margin: 0;">
      <span class="ai-sparkle">🤖</span>
      <h2 style="font-size: 1.15rem; font-weight: 700; color: #fff;">AI At-Risk Student Intelligence Leaderboard</h2>
    </div>
    <a href="/admin/at-risk" class="btn btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">View Full Report →</a>
  </div>

  <div class="table-container">
    <table class="custom-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Roll No</th>
          <th>Attendance</th>
          <th>Academic Score</th>
          <th>Trajectory</th>
          <th>AI Risk Score</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (atRiskStudents && atRiskStudents.length > 0) { %>
          <% atRiskStudents.forEach(item => { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <img src="<%= item.student.avatar %>" style="width: 32px; height: 32px; border-radius: 50%;">
                  <div>
                    <strong style="color: #fff;"><%= item.student.name %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-dim);"><%= item.student.className %></div>
                  </div>
                </div>
              </td>
              <td><%= item.student.rollNumber || 'N/A' %></td>
              <td>
                <span class="<%= item.attendance.percentage < 75 ? 'badge badge-high' : 'badge badge-emerald' %>">
                  <%= item.attendance.percentage %>%
                </span>
              </td>
              <td>
                <strong style="color: <%= item.academics.overallPercentage < 60 ? 'var(--accent-rose)' : '#fff' %>">
                  <%= item.academics.overallPercentage %>%
                </strong>
              </td>
              <td style="text-transform: capitalize;"><%= item.academics.performanceTrend %></td>
              <td>
                <span class="badge badge-<%= item.riskAnalysis.riskLevel %>">
                  <%= item.riskAnalysis.riskLevel.toUpperCase() %> (<%= item.riskAnalysis.riskScore %>/100)
                </span>
              </td>
              <td>
                <button class="btn btn-ai" style="padding: 0.35rem 0.7rem; font-size: 0.75rem;" onclick="viewAiInsight('<%= item.student.id %>')">
                  ✨ View AI Diagnostic
                </button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
              🎉 No high or moderate risk students flagged. All students performing within normal bounds!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  async function viewAiInsight(studentId) {
    openModal('aiModal');
    const container = document.getElementById('aiModalContent');
    container.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-muted);">🤖 Generating real-time Gemini AI diagnostic...</div>';

    try {
      const res = await API.triggerAiInsight(studentId);
      if (res.success && res.data) {
        const d = res.data;
        container.innerHTML = `
          <div class="ai-banner" style="margin-bottom: 1.25rem;">
            <p class="ai-body">${d.summary}</p>
            <div style="margin-top: 0.8rem; font-size: 0.75rem; color: var(--accent-cyan); font-weight: 600;">
              Generated via: ${d.generatedBy}
            </div>
          </div>

          <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 0.95rem;">Key Strengths:</h4>
          <ul style="color: var(--text-muted); margin-left: 1.25rem; font-size: 0.88rem; margin-bottom: 1rem;">
            ${(d.strengths || []).map(s => `<li>${s}</li>`).join('')}
          </ul>

          <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 0.95rem;">Personalized Recommendations:</h4>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            ${(d.recommendations || []).map(r => `
              <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 8px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                  <strong style="color: var(--accent-cyan); font-size: 0.85rem;">${r.topic}</strong>
                  <span class="badge badge-${r.priority === 'High' ? 'high' : 'moderate'}">${r.priority} Priority</span>
                </div>
                <div style="font-size: 0.82rem; color: #d1d5db;">${r.action}</div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 0.25rem;">Resource: ${r.resourceType}</div>
              </div>
            `).join('')}
          </div>
        `;
      }
    } catch(err) {
      container.innerHTML = '<div style="color: var(--accent-rose); text-align: center;">Failed to generate AI diagnostic.</div>';
    }
  }
</script>
