<div class="top-header">
  <div class="header-title">
    <h1>AI At-Risk Student Intelligence Monitor</h1>
    <p>Automated multi-factor risk assessment & predictive early intervention engine</p>
  </div>
</div>

<div class="ai-banner" style="margin-bottom: 1.5rem;">
  <div class="ai-header">
    <span class="ai-sparkle">🧠</span>
    <div class="ai-title">AI At-Risk Multi-Factor Detection Schema</div>
  </div>
  <p class="ai-body">
    Students are evaluated continuously across 4 core risk vectors: Attendance (<75%), Cumulative Exam Scores (<65%), Assignment Submission Rate (<50%), and Performance Trajectory Velocity (Declining). High-risk scores automatically trigger personalized study plans and parent alert summaries.
  </p>
</div>

<div class="glass-card">
  <div class="table-container">
    <table class="custom-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Roll No</th>
          <th>Attendance</th>
          <th>Academic Marks</th>
          <th>Trajectory</th>
          <th>Pending Tasks</th>
          <th>AI Risk Index</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (atRiskStudents && atRiskStudents.length > 0) { %>
          <% atRiskStudents.forEach(item => { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <img src="<%= item.student.avatar %>" style="width: 36px; height: 36px; border-radius: 50%;">
                  <div>
                    <strong style="color: #fff;"><%= item.student.name %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-dim);"><%= item.student.className %></div>
                  </div>
                </div>
              </td>
              <td><%= item.student.rollNumber || 'N/A' %></td>
              <td>
                <span class="<%= item.attendance.percentage < 75 ? 'badge badge-high' : 'badge badge-emerald' %>">
                  <%= item.attendance.percentage %>%
                </span>
              </td>
              <td>
                <strong style="color: <%= item.academics.overallPercentage < 60 ? 'var(--accent-rose)' : '#fff' %>">
                  <%= item.academics.overallPercentage %>%
                </strong>
              </td>
              <td style="text-transform: capitalize;"><%= item.academics.performanceTrend %></td>
              <td><%= item.assignments.pendingAssignmentsCount %> Pending</td>
              <td>
                <span class="badge badge-<%= item.riskAnalysis.riskLevel %>">
                  <%= item.riskAnalysis.riskLevel.toUpperCase() %> (<%= item.riskAnalysis.riskScore %>/100)
                </span>
              </td>
              <td>
                <button class="btn btn-ai" style="padding: 0.35rem 0.7rem; font-size: 0.78rem;" onclick="viewAiInsight('<%= item.student.id %>')">
                  ✨ AI Intervention Plan
                </button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3rem;">
              🎉 Excellent! No students are currently flagged for academic risk.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  async function viewAiInsight(studentId) {
    openModal('aiModal');
    const container = document.getElementById('aiModalContent');
    container.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-muted);">🤖 Generating real-time Gemini AI diagnostic...</div>';

    try {
      const res = await API.triggerAiInsight(studentId);
      if (res.success && res.data) {
        const d = res.data;
        container.innerHTML = `
          <div class="ai-banner" style="margin-bottom: 1.25rem;">
            <p class="ai-body">${d.summary}</p>
            <div style="margin-top: 0.8rem; font-size: 0.75rem; color: var(--accent-cyan); font-weight: 600;">
              Generated via: ${d.generatedBy}
            </div>
          </div>

          <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 0.95rem;">Target Support Areas:</h4>
          <ul style="color: var(--accent-rose); margin-left: 1.25rem; font-size: 0.88rem; margin-bottom: 1rem;">
            ${(d.supportAreas || []).map(s => `<li>${s}</li>`).join('')}
          </ul>

          <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 0.95rem;">Recommended Intervention Plan:</h4>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            ${(d.recommendations || []).map(r => `
              <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 8px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                  <strong style="color: var(--accent-cyan); font-size: 0.85rem;">${r.topic}</strong>
                  <span class="badge badge-${r.priority === 'High' ? 'high' : 'moderate'}">${r.priority} Priority</span>
                </div>
                <div style="font-size: 0.82rem; color: #d1d5db;">${r.action}</div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 0.25rem;">Resource: ${r.resourceType}</div>
              </div>
            `).join('')}
          </div>
        `;
      }
    } catch(err) {
      container.innerHTML = '<div style="color: var(--accent-rose); text-align: center;">Failed to generate AI diagnostic.</div>';
    }
  }
</script>
