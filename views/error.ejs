<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body style="align-items: center; justify-content: center; text-align: center; height: 100vh;">
  <div class="glass-card" style="max-width: 480px; width: 90%; padding: 3rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h2 style="font-size: 1.5rem; color: #fff; margin-bottom: 0.75rem;"><%= title %></h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;"><%= message %></p>
    <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
  </div>
</body>
</html>
